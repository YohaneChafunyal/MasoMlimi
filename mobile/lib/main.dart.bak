class ScanReviewPage extends StatefulWidget {
  final String lang, deviceId, hostKey, organismHint;
  final String photoPath;
  const ScanReviewPage({
    super.key,
    required this.lang,
    required this.deviceId,
    required this.hostKey,
    required this.organismHint,
    required this.photoPath,
  });
  @override
  State<ScanReviewPage> createState() => _ScanReviewPageState();
}

class _ScanReviewPageState extends State<ScanReviewPage> {
  final selected = <String>{};
  bool danger = false;
  final notes = TextEditingController();

  List<Map<String, String>> get cropSigns => const [
        {'key': 'yellow_leaves', 'label': 'Yellow leaves'},
        {'key': 'spots', 'label': 'Spots on leaves'},
        {'key': 'holes', 'label': 'Holes / chewed leaves'},
        {'key': 'wilting', 'label': 'Wilting'},
        {'key': 'stunted', 'label': 'Stunted growth'},
        {'key': 'rot', 'label': 'Rot / soft tissue'},
        {'key': 'insects_seen', 'label': 'Insects seen'},
      ];

  List<Map<String, String>> get animalSigns => const [
        {'key': 'not_eating', 'label': 'Not eating'},
        {'key': 'weak', 'label': 'Weak / lying down'},
        {'key': 'diarrhea', 'label': 'Diarrhea'},
        {'key': 'cough', 'label': 'Cough / breathing hard'},
        {'key': 'skin', 'label': 'Skin / feathers problem'},
        {'key': 'sudden_many_dead', 'label': 'Many sudden deaths'},
        {'key': 'high_fever_group', 'label': 'Fever in several animals'},
      ];

  @override
  Widget build(BuildContext context) {
    final signs = widget.organismHint == 'livestock' ? animalSigns : cropSigns;
    return Scaffold(
      backgroundColor: const Color(0xFFF3F4F6),
      appBar: AppBar(title: const Text('Scan review')),
      body: ListView(
        padding: const EdgeInsets.all(16),
        children: [
          ClipRRect(
            borderRadius: BorderRadius.circular(20),
            child: Image.file(File(widget.photoPath), height: 180, width: double.infinity, fit: BoxFit.cover),
          ),
          const SizedBox(height: 14),
          Container(
            padding: const EdgeInsets.all(16),
            decoration: BoxDecoration(color: Colors.white, borderRadius: BorderRadius.circular(20)),
            child: Column(
              crossAxisAlignment: CrossAxisAlignment.start,
              children: [
                Text(hostLabel(widget.hostKey, widget.lang), style: const TextStyle(fontWeight: FontWeight.w800, fontSize: 18)),
                const SizedBox(height: 6),
                const Text(
                  'Select what you see. Guidance comes only from expert-published procedures — the app does not invent medicines.',
                  style: TextStyle(fontSize: 13, color: Color(0xFF6B7280), height: 1.35),
                ),
              ],
            ),
          ),
          const SizedBox(height: 12),
          Container(
            padding: const EdgeInsets.all(14),
            decoration: BoxDecoration(color: Colors.white, borderRadius: BorderRadius.circular(20)),
            child: Column(
              crossAxisAlignment: CrossAxisAlignment.start,
              children: [
                const Text('Signs observed', style: TextStyle(fontWeight: FontWeight.w800)),
                const SizedBox(height: 8),
                Wrap(
                  spacing: 8,
                  runSpacing: 8,
                  children: [
                    for (final s in signs)
                      FilterChip(
                        label: Text(s['label']!),
                        selected: selected.contains(s['key']),
                        onSelected: (v) {
                          setState(() {
                            if (v) {
                              selected.add(s['key']!);
                            } else {
                              selected.remove(s['key']!);
                            }
                          });
                        },
                      ),
                  ],
                ),
                if (widget.organismHint == 'livestock') ...[
                  const SizedBox(height: 8),
                  CheckboxListTile(
                    contentPadding: EdgeInsets.zero,
                    title: const Text('Danger signs (many deaths, bloody discharge, cannot stand)'),
                    value: danger,
                    onChanged: (v) => setState(() => danger = v ?? false),
                  ),
                ],
                TextField(
                  controller: notes,
                  decoration: const InputDecoration(
                    labelText: 'Extra notes (optional)',
                    border: OutlineInputBorder(),
                  ),
                  maxLines: 2,
                ),
              ],
            ),
          ),
          const SizedBox(height: 20),
          FilledButton.icon(
            onPressed: () {
              // Chat first — guidance only after farmer asks for advice
              Navigator.of(context).pushReplacement(MaterialPageRoute(
                builder: (_) => KnowledgeChatPage(
                  lang: widget.lang,
                  deviceId: widget.deviceId,
                  hostKey: widget.hostKey,
                  organismType: widget.organismHint,
                  scanOutcome: '',
                  photoPath: widget.photoPath,
                  symptomKeys: selected.toList(),
                  dangerSigns: danger,
                  notes: notes.text.trim(),
                  startWithChat: true,
                ),
              ));
            },
            icon: const Icon(Icons.chat_bubble_outline),
            label: Text(t(widget.lang, 'continueChat')),
          ),
        ],
      ),
    );
  }
}


class ResultPage extends StatefulWidget {
  final String lang, deviceId, hostKey, organismHint;
  final String? photoPath;
  final List<String> symptomKeys;
  final bool dangerSigns;
  final String notes;
  const ResultPage({
    super.key,
    required this.lang,
    required this.deviceId,
    required this.hostKey,
    required this.organismHint,
    this.photoPath,
    this.symptomKeys = const [],
    this.dangerSigns = false,
    this.notes = '',
  });
  @override
  State<ResultPage> createState() => _ResultPageState();
}

class _ResultPageState extends State<ResultPage> {
  bool loading = true;
  Map<String, dynamic>? result;
  String? errorLine;
  String lastUrl = '';

  @override
  void initState() {
    super.initState();
    run();
  }

  Map<String, dynamic>? _asMap(dynamic v) {
    if (v is Map<String, dynamic>) return v;
    if (v is Map) return Map<String, dynamic>.from(v);
    return null;
  }

  List _asList(dynamic v) {
    if (v is List) return v;
    return const [];
  }

  Future<void> run({bool danger = false}) async {
    setState(() {
      loading = true;
      errorLine = null;
    });
    lastUrl = '$kApiBase/v1/diagnosis/diagnose';
    try {
      http.Response res;
      if (widget.photoPath != null) {
        lastUrl = '$kApiBase/v1/scan/analyze';
        final req = http.MultipartRequest('POST', Uri.parse(lastUrl));
        req.fields['host_key'] = widget.hostKey;
        req.fields['organism_hint'] = widget.organismHint;
        req.fields['language'] = widget.lang;
        req.fields['device_id'] = widget.deviceId;
        req.fields['danger_signs_present'] = (danger || widget.dangerSigns).toString();
        req.files.add(await http.MultipartFile.fromPath('image', widget.photoPath!));
        final streamed = await req.send().timeout(const Duration(seconds: 30));
        res = await http.Response.fromStream(streamed);
      } else {
        res = await http
            .post(
              Uri.parse(lastUrl),
              headers: {'Content-Type': 'application/json', 'Accept': 'application/json'},
              body: jsonEncode({
                'host_key': widget.hostKey,
                'organism_hint': widget.organismHint,
                'danger_signs_present': danger || widget.dangerSigns,
                'symptom_keys': widget.symptomKeys,
                'answers': widget.notes.isEmpty ? {} : {'notes': widget.notes},
                'language': widget.lang,
                'device_id': widget.deviceId,
              }),
            )
            .timeout(const Duration(seconds: 15));
      }
      if (res.statusCode != 200) {
        setState(() {
          errorLine = 'HTTP ${res.statusCode}: ${res.body}';
          result = {
            'outcome': 'not_sure',
            'result_color': 'red',
            'messages': {'primary': 'Server error ${res.statusCode}', 'ask_expert_note': t(widget.lang, 'callExpert')},
            'procedure_steps': [],
          };
        });
        return;
      }
      final decoded = jsonDecode(res.body);
      final data = _asMap(decoded) ?? <String, dynamic>{};
      setState(() => result = data);
      // Refresh procedure pack in background for next offline use
      try {
        final pr = await http.get(Uri.parse('$kApiBase/v1/procedures')).timeout(const Duration(seconds: 6));
        if (pr.statusCode == 200) {
          final pdata = jsonDecode(pr.body);
          final items = pdata is Map ? (pdata['items'] as List? ?? []) : [];
          await OfflineCache.saveProcedures(items);
          await OfflineCache.flushOutbox(kApiBase);
        }
      } catch (_) {}

      final cond = _asMap(data['condition']);
      final title = '${cond?['common_name'] ?? data['outcome'] ?? ''}';
      final p = await SharedPreferences.getInstance();
      final cases = jsonDecode(p.getString('cases') ?? '[]') as List;
      cases.insert(0, {
        'host_key': widget.hostKey,
        'outcome': data['outcome'],
        'color': data['result_color'],
        'title': title,
        'at': DateTime.now().toIso8601String(),
      });
      await p.setString('cases', jsonEncode(cases.take(40).toList()));
    } catch (e) {
      // Offline: use last downloaded published procedures
      final cached = await OfflineCache.loadProcedures();
      final matched = OfflineCache.matchPublished(cached, widget.hostKey, widget.symptomKeys);
      if (matched != null) {
        setState(() {
          errorLine = 'Offline — showing saved expert guidance';
          result = OfflineCache.resultFromProcedure(matched, widget.lang);
        });
      } else {
        setState(() {
          errorLine = 'Offline and no saved guidance for this crop/animal yet. Open app online once to download.';
          result = {
            'outcome': 'not_sure',
            'result_color': 'red',
            'messages': {
              'primary': 'No offline pack for this host. Connect once to download published guides.',
              'ask_expert_note': t(widget.lang, 'callExpert'),
            },
            'procedure_steps': [],
          };
        });
      }
    } finally {
      setState(() => loading = false);
    }
  }

  @override
  Widget build(BuildContext context) {
    final steps = _asList(result?['procedure_steps']);
    final prevention = _asList(result?['prevention_steps']);
    final cond = _asMap(result?['condition']);
    final msgs = _asMap(result?['messages']);
    final name = '${cond?['common_name'] ?? hostLabel(widget.hostKey, widget.lang)}';
    final primary = '${msgs?['primary'] ?? ''}';
    final published = result?['from_published_library'] == true;
    final outcome = '${result?['outcome'] ?? ''}';

    return Scaffold(
      appBar: AppBar(
        title: Text(t(widget.lang, 'result')),
        actions: [
          IconButton(icon: const Icon(Icons.refresh), onPressed: () => run()),
        ],
      ),
      body: loading
          ? const Center(child: CircularProgressIndicator())
          : ListView(
              padding: const EdgeInsets.all(16),
              children: [
                // Always show connection status so farmers/dev can see if API was hit
                DashCard(
                  color: published ? C.greenSoft : (errorLine != null ? C.redSoft : C.amberSoft),
                  child: Column(
                    crossAxisAlignment: CrossAxisAlignment.start,
                    children: [
                      Text(
                        published
                            ? 'Expert-published guidance'
                            : (errorLine != null ? 'Could not load from server' : 'Result'),
                        style: const TextStyle(fontWeight: FontWeight.w800),
                      ),
                      const SizedBox(height: 4),
                      Text('API: $kApiBase', style: const TextStyle(fontSize: 11, color: C.muted)),
                      if (outcome.isNotEmpty) Text('${t(widget.lang, 'outcome')}: $outcome', style: const TextStyle(fontSize: 12)),
                      if (errorLine != null) Text(errorLine!, style: const TextStyle(fontSize: 12, color: C.red)),
                    ],
                  ),
                ),
                const SizedBox(height: 12),
                if (widget.photoPath != null)
                  ClipRRect(
                    borderRadius: BorderRadius.circular(16),
                    child: Image.file(File(widget.photoPath!), height: 160, width: double.infinity, fit: BoxFit.cover),
                  ),
                const SizedBox(height: 12),
                Text(t(widget.lang, 'likely'), style: const TextStyle(fontWeight: FontWeight.w800)),
                const SizedBox(height: 8),
                SoftListCard(
                  leading: Icon(hostIcon(widget.hostKey), color: C.greenDark),
                  leadingBg: hostTint(widget.hostKey),
                  title: name,
                  subtitle: hostLabel(widget.hostKey, widget.lang),
                  trailing: const SizedBox.shrink(),
                ),
                if (primary.isNotEmpty) ...[
                  const SizedBox(height: 8),
                  Text(primary, style: const TextStyle(height: 1.35)),
                ],
                if (msgs?['published_note'] != null) ...[
                  const SizedBox(height: 6),
                  Text('${msgs!['published_note']}', style: const TextStyle(fontSize: 12, color: C.muted)),
                ],
                const SizedBox(height: 14),
                Text(t(widget.lang, 'cando'), style: const TextStyle(fontWeight: FontWeight.w800)),
                const SizedBox(height: 8),
                if (steps.isEmpty)
                  SoftListCard(
                    leading: const Icon(Icons.support_agent, color: C.greenDark),
                    title: '${msgs?['ask_expert_note'] ?? t(widget.lang, 'callExpert')}',
                    trailing: const SizedBox.shrink(),
                  )
                else
                  ...steps.map((s) {
                    String text;
                    if (s is Map) {
                      text = '${s['text'] ?? s}';
                    } else {
                      text = '$s';
                    }
                    return Padding(
                      padding: const EdgeInsets.only(bottom: 8),
                      child: SoftListCard(
                        leading: const Icon(Icons.check_circle_outline, color: C.greenDark),
                        title: text,
                        trailing: const SizedBox.shrink(),
                      ),
                    );
                  }),
                if (prevention.isNotEmpty) ...[
                  const SizedBox(height: 12),
                  Text(t(widget.lang, 'prevention'), style: const TextStyle(fontWeight: FontWeight.w800)),
                  const SizedBox(height: 8),
                  ...prevention.map((s) {
                    final text = s is Map ? '${s['text'] ?? s}' : '$s';
                    if (text.startsWith('Sign:')) {
                      return Padding(
                        padding: const EdgeInsets.only(bottom: 6),
                        child: SoftListCard(
                          leading: const Icon(Icons.visibility_outlined, color: C.amber),
                          title: text.replaceFirst('Sign: ', ''),
                          trailing: const SizedBox.shrink(),
                        ),
                      );
                    }
                    return Padding(
                      padding: const EdgeInsets.only(bottom: 6),
                      child: SoftListCard(
                        leading: const Icon(Icons.shield_outlined, color: C.greenDark),
                        title: text,
                        trailing: const SizedBox.shrink(),
                      ),
                    );
                  }),
                ],
                if (widget.organismHint == 'livestock') ...[
                  const SizedBox(height: 8),
                  OutlinedButton(onPressed: () => run(danger: true), child: Text(t(widget.lang, 'danger'))),
                ],
                const SizedBox(height: 16),
                FilledButton.icon(
                  onPressed: () {
                    final outcome = '${result?['outcome'] ?? ''}';
                    Navigator.of(context).push(MaterialPageRoute(
                      builder: (_) => KnowledgeChatPage(
                        lang: widget.lang,
                        deviceId: widget.deviceId,
                        hostKey: widget.hostKey,
                        organismType: widget.organismHint,
                        scanOutcome: outcome,
                      ),
                    ));
                  },
                  icon: const Icon(Icons.chat_bubble_outline),
                  label: Text(t(widget.lang, 'confirmDescribe')),
                ),
                const SizedBox(height: 8),
                FilledButton.icon(
                  onPressed: () => Navigator.of(context).push(MaterialPageRoute(builder: (_) => ExpertsPage(lang: widget.lang))),
                  icon: const Icon(Icons.phone),
                  label: Text(t(widget.lang, 'callExpert')),
                ),
              ],
            ),
    );
  }
}


class ExpertsPage extends StatefulWidget {
  final String lang;
  const ExpertsPage({super.key, required this.lang});
  @override
  State<ExpertsPage> createState() => _ExpertsPageState();
}

class _ExpertsPageState extends State<ExpertsPage> {
  List experts = [];
  String deviceId = '';

  @override
  void initState() {
    super.initState();
    _load();
  }

  Future<void> _load() async {
    final p = await SharedPreferences.getInstance();
    deviceId = p.getString('device_id') ?? '';
    // Instant offline paint
    final cached = await OfflineCache.loadExperts();
    if (mounted && cached.isNotEmpty) setState(() => experts = cached);
    List loaded = [];
    try {
      for (final q in ['district=all', 'district=Dowa', 'district=Lilongwe', '']) {
        final url = q.isEmpty ? '$kApiBase/v1/experts/' : '$kApiBase/v1/experts/?country=MW&$q';
        final res = await http.get(Uri.parse(url)).timeout(const Duration(seconds: 6));
        if (res.statusCode == 200) {
          final data = jsonDecode(res.body);
          if (data is List && data.isNotEmpty) {
            loaded = data;
            break;
          }
        }
      }
    } catch (_) {}
    if (loaded.isNotEmpty) {
      await OfflineCache.saveExperts(loaded);
      if (mounted) setState(() => experts = loaded);
    } else if (mounted && experts.isEmpty) {
      setState(() => experts = cached);
    }
  }

  @override
  Widget build(BuildContext context) {
    return Scaffold(
      appBar: AppBar(
        title: Text(t(widget.lang, 'experts')),
        actions: [IconButton(icon: const Icon(Icons.refresh), onPressed: _load)],
      ),
      body: ListView(
        padding: const EdgeInsets.all(16),
        children: [
          Text(t(widget.lang, 'availableOfficers'), style: const TextStyle(fontWeight: FontWeight.w800, fontSize: 16)),
          const SizedBox(height: 4),
          const Text('Chat, voice or video with verified district staff.', style: TextStyle(color: C.muted, fontSize: 13)),
          const SizedBox(height: 12),
          if (experts.isEmpty)
            const DashCard(
              child: Text(
                'No officers registered yet. District staff must add their names in the Expert Portal (Officers tab).',
                style: TextStyle(color: C.muted, height: 1.35),
              ),
            )
          else
          ...experts.map((e) {
            final name = '${e['display_name']}';
            final role = '${e['role_label'] ?? ''}';
            final avail = '${e['availability'] ?? ''}';
            final id = '${e['id'] ?? name}';
            final phone = e['phone_e164'];
            return Padding(
              padding: const EdgeInsets.only(bottom: 12),
              child: DashCard(
                child: Column(
                  crossAxisAlignment: CrossAxisAlignment.start,
                  children: [
                    Row(
                      children: [
                        CircleAvatar(
                          backgroundColor: C.greenSoft,
                          child: Text(name.isNotEmpty ? name[0] : '?', style: const TextStyle(color: C.greenDark, fontWeight: FontWeight.w800)),
                        ),
                        const SizedBox(width: 12),
                        Expanded(
                          child: Column(
                            crossAxisAlignment: CrossAxisAlignment.start,
                            children: [
                              Text(name, style: const TextStyle(fontWeight: FontWeight.w800)),
                              Text('$role · ${e['district'] ?? ''}', style: const TextStyle(color: C.muted, fontSize: 12)),
                              Text(avail, style: TextStyle(color: avail == 'available' ? C.greenDark : C.muted, fontSize: 12, fontWeight: FontWeight.w600)),
                            ],
                          ),
                        ),
                      ],
                    ),
                    const SizedBox(height: 12),
                    Row(
                      children: [
                        Expanded(
                          child: FilledButton.icon(
                            onPressed: () {
                              Navigator.of(context).push(MaterialPageRoute(
                                builder: (_) => ExpertChatPage(
                                  lang: widget.lang,
                                  deviceId: deviceId,
                                  expertId: id,
                                  expertName: name,
                                  expertRole: role,
                                  phone: phone is String ? phone : null,
                                ),
                              ));
                            },
                            icon: const Icon(Icons.chat_bubble_outline, size: 18),
                            label: const Text('Chat'),
                          ),
                        ),
                        const SizedBox(width: 8),
                        Expanded(
                          child: OutlinedButton.icon(
                            onPressed: phone != null
                                ? () => launchUrl(Uri.parse('tel:$phone'))
                                : () {
                                    ScaffoldMessenger.of(context).showSnackBar(
                                      const SnackBar(content: Text('Phone number not listed — use Chat or office hours')),
                                    );
                                  },
                            icon: const Icon(Icons.call, size: 18),
                            label: const Text('Call'),
                          ),
                        ),
                      ],
                    ),
                  ],
                ),
              ),
            );
          }),
          SoftListCard(
            leading: const Icon(Icons.account_balance, color: C.greenDark),
            title: 'District agriculture office',
            subtitle: 'General enquiries and support',
            trailing: const SizedBox.shrink(),
          ),
        ],
      ),
    );
  }
}

class ExpertChatPage extends StatefulWidget {
  final String lang, deviceId, expertId, expertName, expertRole;
  final String? phone;
  const ExpertChatPage({
    super.key,
    required this.lang,
    required this.deviceId,
    required this.expertId,
    required this.expertName,
    required this.expertRole,
    this.phone,
  });
  @override
  State<ExpertChatPage> createState() => _ExpertChatPageState();
}

class _ExpertChatPageState extends State<ExpertChatPage> {
  final _ctrl = TextEditingController();
  final _recorder = AudioRecorder();
  final _player = AudioPlayer();

  Future<void> _playVoiceNote(Map m) async {
    try {
      await _player.stop();
      final local = '${m['local_path'] ?? ''}';
      if (local.isNotEmpty) {
        final f = File(local);
        if (await f.exists() && await f.length() > 200) {
          await _player.play(DeviceFileSource(local));
          return;
        }
      }
      final text = '${m['text'] ?? ''}';
      final match = RegExp(r'\[voice_note:([^\]]+)\]').firstMatch(text);
      final name = match?.group(1);
      if (name != null && name.isNotEmpty) {
        final prefs = await SharedPreferences.getInstance();
        final mapped = prefs.getString('voice_local_$name') ?? '';
        if (mapped.isNotEmpty) {
          final mf = File(mapped);
          if (await mf.exists() && await mf.length() > 200) {
            await _player.play(DeviceFileSource(mapped));
            return;
          }
        }
        final dir = await getApplicationDocumentsDirectory();
        final cache = File('${dir.path}/masomlimi_offline/voice_cache/$name');
        if (await cache.exists() && await cache.length() > 200) {
          await _player.play(DeviceFileSource(cache.path));
          return;
        }
        await cache.parent.create(recursive: true);
        final uri = Uri.parse('$kApiBase/v1/chat/voice/$name');
        final res = await http.get(uri).timeout(const Duration(seconds: 25));
        final bytes = res.bodyBytes;
        if (res.statusCode == 200 && bytes.length > 200) {
          await cache.writeAsBytes(bytes);
          await prefs.setString('voice_local_$name', cache.path);
          await _player.play(DeviceFileSource(cache.path));
          return;
        }
        throw Exception(
          'Server ${res.statusCode}, ${bytes.length} bytes (need >200). Re-record longer. Check API.',
        );
      }
      if (mounted) {
        ScaffoldMessenger.of(context).showSnackBar(
          const SnackBar(content: Text('No audio on this bubble — re-record and send')),
        );
      }
    } catch (e) {
      if (mounted) {
        ScaffoldMessenger.of(context).showSnackBar(
          SnackBar(content: Text('Cannot play: $e')),
        );
      }
    }
  }
  List messages = [];
  bool loading = true;
  bool _recording = false;
  bool _voiceBusy = false;
  String? _recordPath;
  Timer? _poll;

  @override
  void initState() {
    super.initState();
    refresh();
    _poll = Timer.periodic(const Duration(seconds: 3), (_) => refresh(silent: true));
  }

  @override
  void dispose() {
    _poll?.cancel();
    _ctrl.dispose();
    _recorder.dispose();
    _player.dispose();
    super.dispose();
  }


  Future<void> _toggleVoice() async {
    if (_recording) {
      await _stopAndSendVoice();
    } else {
      await _startVoice();
    }
  }

  Future<void> _startVoice() async {
    try {
      if (await _recorder.isRecording()) {
        await _recorder.stop();
      }
      final ok = await _recorder.hasPermission();
      if (!ok) {
        if (mounted) {
          ScaffoldMessenger.of(context).showSnackBar(
            const SnackBar(content: Text('Allow microphone in Android settings for MasoMlimi')),
          );
        }
        return;
      }
      final dir = await getApplicationDocumentsDirectory();
      final voiceDir = Directory('${dir.path}/masomlimi_offline/voice_notes');
      if (!await voiceDir.exists()) await voiceDir.create(recursive: true);
      _recordPath = '${voiceDir.path}/vn_${DateTime.now().millisecondsSinceEpoch}.m4a';
      // Try AAC first; fall back to WAV for emulator compatibility
      try {
        await _recorder.start(
          const RecordConfig(encoder: AudioEncoder.aacLc, numChannels: 1, bitRate: 128000, sampleRate: 44100),
          path: _recordPath!,
        );
      } catch (_) {
        _recordPath = '${voiceDir.path}/vn_${DateTime.now().millisecondsSinceEpoch}.wav';
        await _recorder.start(
          const RecordConfig(encoder: AudioEncoder.wav, numChannels: 1, sampleRate: 16000),
          path: _recordPath!,
        );
      }
      if (!mounted) return;
      setState(() => _recording = true);
      ScaffoldMessenger.of(context).showSnackBar(
        const SnackBar(content: Text('Recording… speak now, then tap mic to send'), duration: Duration(seconds: 3)),
      );
    } catch (e) {
      if (mounted) {
        setState(() => _recording = false);
        ScaffoldMessenger.of(context).showSnackBar(
          SnackBar(content: Text('Could not start mic: $e')),
        );
      }
    }
  }

  Future<void> _stopAndSendVoice() async {
    try {
      String? filePath;
      try {
        filePath = await _recorder.stop();
      } catch (_) {}
      filePath = filePath ?? _recordPath;
      if (!mounted) return;
      setState(() => _recording = false);
      if (filePath == null || filePath.isEmpty) {
        ScaffoldMessenger.of(context).showSnackBar(
          const SnackBar(content: Text('No audio captured — try again')),
        );
        return;
      }
      final f = File(filePath);
      if (!await f.exists() || await f.length() < 800) {
        ScaffoldMessenger.of(context).showSnackBar(
          const SnackBar(content: Text('No voice captured — speak longer, check mic permission')),
        );
        return;
      }
      await _sendVoiceFile(filePath);
    } catch (e) {
      if (mounted) {
        setState(() => _recording = false);
        ScaffoldMessenger.of(context).showSnackBar(SnackBar(content: Text('Voice error: $e')));
      }
    }
  }

  Future<void> _sendVoiceFile(String filePath) async {
    if (_voiceBusy) return;
    _voiceBusy = true;
    try {
      // Drop any pending outbox audio for same file (avoid double POST)
      final box = await OfflineCache.loadOutbox();
      final cleaned = box.where((o) {
        if (o is! Map) return true;
        if ('${o['type']}' != 'audio_note') return true;
        return '${o['file_path']}' != filePath;
      }).toList();
      await OfflineCache.saveOutbox(cleaned);

      await OfflineCache.enqueueOutbox({
        'type': 'audio_note',
        'device_id': widget.deviceId,
        'expert_id': widget.expertId,
        'sender': 'farmer',
        'file_path': filePath,
        'msg_type': 'audio_note',
        'text': '[Voice note]',
        'client_id': 'vn-${DateTime.now().millisecondsSinceEpoch}',
      });

      try {
        final sent = await OfflineCache.flushOutbox(kApiBase);
        if (sent > 0) {
          // Only server messages — do not add a local voice bubble
          await refresh(silent: true);
          if (mounted) {
            setState(() {
              messages = OfflineCache.dedupeMessages(messages);
            });
            ScaffoldMessenger.of(context).showSnackBar(const SnackBar(content: Text('Voice note sent')));
          }
          return;
        }
      } catch (_) {}

      // Offline: single local placeholder only
      final localMsg = {
        'id': 'local-vn-${DateTime.now().millisecondsSinceEpoch}',
        'sender': 'farmer',
        'type': 'audio_note',
        'text': '[Voice note]',
        'at': DateTime.now().toIso8601String(),
        'pending_sync': true,
        'local_path': filePath,
      };
      await OfflineCache.appendOutgoingChat(widget.deviceId, widget.expertId, localMsg);
      if (mounted) {
        setState(() => messages = OfflineCache.dedupeMessages([...messages, localMsg]));
        ScaffoldMessenger.of(context).showSnackBar(
          const SnackBar(content: Text('Voice saved offline — will sync when online')),
        );
      }
    } finally {
      _voiceBusy = false;
    }
  }


  Future<void> refresh({bool silent = false}) async {
    // Always try to push outbox first when we have network
    try {
      await OfflineCache.flushOutbox(kApiBase);
    } catch (_) {}

    List server = [];
    var onlineOk = false;
    try {
      final res = await http
          .get(Uri.parse('$kApiBase/v1/chat/${widget.deviceId}/${widget.expertId}'))
          .timeout(const Duration(seconds: 6));
      if (res.statusCode == 200) {
        final data = jsonDecode(res.body) as Map;
        server = (data['messages'] as List?) ?? [];
        onlineOk = true;
      }
    } catch (_) {}

    final local = await OfflineCache.loadChat(widget.deviceId, widget.expertId);
    final outbox = await OfflineCache.loadOutbox();
    // Pending only if still in outbox (not yet delivered)
    bool stillQueued(Map m) {
      final id = '${m['id'] ?? ''}';
      final text = '${m['text'] ?? ''}';
      final path = '${m['local_path'] ?? ''}';
      for (final o in outbox) {
        if (o is! Map) continue;
        if (path.isNotEmpty && '${o['file_path']}' == path) return true;
        if (text.isNotEmpty && '${o['text']}' == text && '${o['expert_id']}' == widget.expertId) return true;
      }
      return false;
    }

    List merged;
    if (onlineOk) {
      merged = List.from(server);
      for (final p in local) {
        if (p is! Map) continue;
        if (p['pending_sync'] != true) continue;
        if (!stillQueued(p)) continue; // already delivered — server copy is enough
        // Avoid duplicate voice: if server already has any voice note, skip local placeholder
        final isVoice = p['type'] == 'audio_note' || '${p['text']}'.contains('Voice note');
        if (isVoice) {
          final serverHasVoice = server.any((s) =>
              s is Map &&
              (s['type'] == 'audio_note' || '${s['text']}'.contains('[voice_note:')));
          if (serverHasVoice) continue;
        }
        final text = '${p['text']}';
        final exists = server.any((s) => s is Map && '${s['text']}' == text);
        if (!exists) merged.add(p);
      }
      await OfflineCache.saveChat(widget.deviceId, widget.expertId, merged);
    } else {
      merged = local.isNotEmpty ? local : server;
    }

    merged = OfflineCache.dedupeMessages(merged);
    if (!mounted) return;
    setState(() {
      messages = merged;
      loading = false;
    });
  }

  Future<void> send({String type = 'text', String? text}) async {
    final body = text ?? _ctrl.text.trim();
    if (body.isEmpty && type == 'text') return;
    final localMsg = {
      'id': 'local-${DateTime.now().millisecondsSinceEpoch}',
      'sender': 'farmer',
      'type': type,
      'text': body,
      'at': DateTime.now().toIso8601String(),
      'pending_sync': true,
    };
    // Always keep on device first
    await OfflineCache.enqueueOutbox({
      'type': 'text',
      'device_id': widget.deviceId,
      'expert_id': widget.expertId,
      'sender': 'farmer',
      'text': body,
      'msg_type': type,
    });
    _ctrl.clear();

    try {
      final sent = await OfflineCache.flushOutbox(kApiBase);
      if (sent > 0) {
        await refresh();
        return;
      }
    } catch (_) {}

    await OfflineCache.appendOutgoingChat(widget.deviceId, widget.expertId, localMsg);
    if (mounted) {
      setState(() => messages = OfflineCache.dedupeMessages([...messages, localMsg]));
      ScaffoldMessenger.of(context).showSnackBar(
        const SnackBar(content: Text('Saved offline. Will sync when online.')),
      );
    }
  }

  @override
  Widget build(BuildContext context) {
    return Scaffold(
      appBar: AppBar(
        title: Column(
          crossAxisAlignment: CrossAxisAlignment.start,
          children: [
            Text(widget.expertName, style: const TextStyle(fontSize: 16, fontWeight: FontWeight.w800)),
            Text(widget.expertRole, style: const TextStyle(fontSize: 12, color: C.muted, fontWeight: FontWeight.w400)),
          ],
        ),
        actions: [
          IconButton(
            tooltip: 'Voice call',
            icon: const Icon(Icons.call),
            onPressed: () {
              if (widget.phone != null) {
                launchUrl(Uri.parse('tel:${widget.phone}'));
              } else {
                send(type: 'audio_note', text: 'Farmer requested a voice call');
                ScaffoldMessenger.of(context).showSnackBar(
                  const SnackBar(content: Text('Voice request sent in chat. Officer will call back when available.')),
                );
              }
            },
          ),
          IconButton(
            tooltip: 'Video call',
            icon: const Icon(Icons.videocam_outlined),
            onPressed: () {
              send(type: 'video_request', text: 'Farmer requested a video call');
              showDialog(
                context: context,
                builder: (ctx) => AlertDialog(
                  title: const Text('Video call'),
                  content: const Text(
                    'A video request was sent to the officer. '
                    'Full live video needs a secure call service in production. '
                    'For this pilot, the officer can reply in chat or call you by phone.',
                  ),
                  actions: [TextButton(onPressed: () => Navigator.pop(ctx), child: const Text('OK'))],
                ),
              );
            },
          ),
        ],
      ),
      body: Column(
        children: [
          Expanded(
            child: loading
                ? const Center(child: CircularProgressIndicator())
                : messages.isEmpty
                    ? Center(child: Text(t(widget.lang, 'noMessages'), textAlign: TextAlign.center))
                    : Builder(builder: (_) {
                        final shown = OfflineCache.dedupeMessages(messages);
                        return ListView.builder(
                        padding: const EdgeInsets.all(12),
                        itemCount: shown.length,
                        itemBuilder: (_, i) {
                          final m = shown[i] as Map;
                          final mine = m['sender'] == 'farmer';
                          final rawType = '${m['type'] ?? 'text'}';
                          final textStr = '${m['text'] ?? ''}';
                          final type = (rawType == 'audio_note' || textStr.contains('[voice_note:') || textStr.contains('[Voice note]'))
                              ? 'audio_note'
                              : rawType;
                          return Align(
                            alignment: mine ? Alignment.centerRight : Alignment.centerLeft,
                            child: Container(
                              margin: const EdgeInsets.symmetric(vertical: 4),
                              padding: const EdgeInsets.symmetric(horizontal: 12, vertical: 10),
                              constraints: BoxConstraints(maxWidth: MediaQuery.of(context).size.width * 0.78),
                              decoration: BoxDecoration(
                                color: mine ? C.greenSoft : Colors.white,
                                borderRadius: BorderRadius.circular(14),
                                border: Border.all(color: C.border),
                              ),
                              child: Column(
                                crossAxisAlignment: CrossAxisAlignment.start,
                                children: [
                                  if (type == 'audio_note') ...[
                                    Row(children: [const Icon(Icons.mic, size: 16), const SizedBox(width: 6), Text(t(widget.lang, 'voiceNote'), style: const TextStyle(fontWeight: FontWeight.w700))]),
                                    TextButton.icon(
                                      onPressed: () => _playVoiceNote(Map<String, dynamic>.from(m)),
                                      icon: const Icon(Icons.play_arrow, size: 18),
                                      label: Text(t(widget.lang, 'play')),
                                    ),
                                  ] else if (type == 'video_request')
                                    const Row(children: [Icon(Icons.videocam, size: 16), SizedBox(width: 6), Text('Video request', style: TextStyle(fontWeight: FontWeight.w700))])
                                  else
                                    Text('${m['text'] ?? ''}', style: const TextStyle(height: 1.3)),
                                ],
                              ),
                            ),
                          );
                        },
                        );
                      }),
          ),
          if (_recording)
            Container(
              width: double.infinity,
              padding: const EdgeInsets.symmetric(vertical: 8, horizontal: 16),
              color: Colors.red.shade50,
              child: const Text('Recording… tap mic again to send',
                  style: TextStyle(color: Colors.red, fontWeight: FontWeight.w700)),
            ),
          SafeArea(
            child: Padding(
              padding: const EdgeInsets.fromLTRB(10, 6, 10, 10),
              child: Row(
                children: [
                  // Tap mic to start, tap again to stop & send (reliable on emulator + phone)
                  IconButton(
                    tooltip: _recording ? 'Tap to send' : 'Tap to record',
                    icon: Icon(
                      _recording ? Icons.stop_circle : Icons.mic,
                      color: _recording ? Colors.red : C.greenDark,
                      size: 30,
                    ),
                    onPressed: _toggleVoice,
                  ),

                  Expanded(
                    child: TextField(
                      controller: _ctrl,
                      decoration: InputDecoration(
                        hintText: t(widget.lang, 'message'),
                        filled: true,
                        fillColor: Colors.white,
                        border: OutlineInputBorder(borderRadius: BorderRadius.circular(24), borderSide: BorderSide.none),
                        contentPadding: const EdgeInsets.symmetric(horizontal: 16, vertical: 10),
                      ),
                      onSubmitted: (_) => send(),
                    ),
                  ),
                  const SizedBox(width: 6),
                  IconButton.filled(
                    onPressed: () => send(),
                    icon: const Icon(Icons.send),
                  ),
                ],
              ),
            ),
          ),
        ],
      ),
    );
  }
}



/// Post-scan: chat first; guidance only when farmer asks for advice (online + offline).

/// Offline phrase translation for advice + short chat messages (pilot glossary).
String translateTo(String text, String lang) {
  if (lang == 'en' || text.isEmpty) return text;
  const glossary = {
    'ny': {
      'From published expert guidance': 'Kuchokera ku uphungu wosindikizidwa',
      'Prevention': 'Kupewa',
      'Medications': 'Mankhwala',
      'Ask a verified officer': 'Funsani katswiri wovomerezeka',
      'Isolate': 'Patulani',
      'Do not': 'Musamachite',
      'Remove': 'Chotsani',
      'Water': 'Madzi',
      'Leaf': 'Tsamba', 'leaves': 'masamba', 'spots': 'mawala',
      'Advice': 'Uphungu',
    },
    'fr': {
      'From published expert guidance': 'D\'après les conseils publiés',
      'Prevention': 'Prévention',
      'Medications': 'Médicaments',
      'Ask a verified officer': 'Demandez à un expert vérifié',
      'Isolate': 'Isoler', 'Remove': 'Retirer', 'Water': 'Eau',
      'Advice': 'Conseil',
    },
    'sw': {
      'From published expert guidance': 'Kutoka mwongozo uliochapishwa',
      'Prevention': 'Kinga', 'Medications': 'Dawa',
      'Ask a verified officer': 'Muulize afisa aliyethibitishwa',
      'Isolate': 'Tenga', 'Remove': 'Ondoa', 'Advice': 'Ushauri',
    },
    'pt': {
      'From published expert guidance': 'Da orientação publicada',
      'Prevention': 'Prevenção', 'Medications': 'Medicamentos',
      'Ask a verified officer': 'Pergunte a um técnico verificado',
      'Isolate': 'Isolar', 'Remove': 'Remover', 'Advice': 'Conselho',
    },
  };
  final g = glossary[lang];
  if (g == null) return text;
  var out = text;
  g.forEach((k, v) {
    out = out.replaceAll(k, v);
    out = out.replaceAll(k.toLowerCase(), v);
  });
  return out;
}

class LocalKb {
  static Future<File> _file() async {
    final dir = await getApplicationDocumentsDirectory();
    final d = Directory('${dir.path}/masomlimi_offline');
    if (!await d.exists()) await d.create(recursive: true);
    return File('${d.path}/local_kb.json');
  }

  static Future<Map<String, dynamic>> load() async {
    try {
      final f = await _file();
      if (!await f.exists()) return {};
      final data = jsonDecode(await f.readAsString());
      return data is Map ? Map<String, dynamic>.from(data) : {};
    } catch (_) {
      return {};
    }
  }

  static Future<void> save(Map<String, dynamic> data) async {
    final f = await _file();
    await f.writeAsString(jsonEncode(data), flush: true);
  }

  /// Learn from interview + published advice for next time (same host only).
  static Future<void> learn({
    required String host,
    required Map answers,
    required String advice,
    String procedureId = '',
  }) async {
    final hk = normalizeHost(host);
    final all = await load();
    final list = List.from(all[hk] is List ? all[hk] as List : []);
    list.add({
      'at': DateTime.now().toUtc().toIso8601String(),
      'answers': answers,
      'advice_summary': advice.length > 800 ? advice.substring(0, 800) : advice,
      'procedure_id': procedureId,
      'signs': '${answers['signs'] ?? ''}'.toLowerCase(),
    });
    // keep last 30 per host
    all[hk] = list.length > 30 ? list.sublist(list.length - 30) : list;
    await save(all);
  }

  static Future<List> forHost(String host) async {
    final all = await load();
    final list = all[normalizeHost(host)];
    return list is List ? list : [];
  }

  static Future<String?> similarAdvice(String host, String signsBlob) async {
    final list = await forHost(host);
    if (list.isEmpty) return null;
    final tokens = signsBlob.toLowerCase().split(RegExp(r'[^a-z0-9]+')).where((w) => w.length > 3).toSet();
    Map? best;
    var bestScore = 0;
    for (final e in list) {
      if (e is! Map) continue;
      final s = '${e['signs'] ?? e['answers']}';
      var score = 0;
      for (final t in tokens) {
        if (s.contains(t)) score++;
      }
      if (score > bestScore) {
        bestScore = score;
        best = e;
      }
    }
    if (bestScore < 1 || best == null) return null;
    return '${best['advice_summary'] ?? ''}';
  }
}

class KnowledgeChatPage extends StatefulWidget {
  final String lang;
  final String deviceId;
  final String hostKey;
  final String organismType;
  final String scanOutcome;
  final String? photoPath;
  final List<String> symptomKeys;
  final bool dangerSigns;
  final String notes;
  final bool startWithChat;
  const KnowledgeChatPage({
    super.key,
    required this.lang,
    required this.deviceId,
    required this.hostKey,
    required this.organismType,
    this.scanOutcome = '',
    this.photoPath,
    this.symptomKeys = const [],
    this.dangerSigns = false,
    this.notes = '',
    this.startWithChat = true,
  });
  @override
  State<KnowledgeChatPage> createState() => _KnowledgeChatPageState();
}

class _KnowledgeChatPageState extends State<KnowledgeChatPage> {
  final _ctrl = TextEditingController();
  final List<Map<String, String>> _msgs = [];
  /// 0 host, 1 part/age, 2 signs, 3 duration, 4 spread, 5 context, 6 tried, 7 ready for advice
  int _phase = 0;
  String _confirmedHost = '';
  String _description = '';
  final Map<String, String> _answers = {};
  bool _busy = false;
  bool _adviceGiven = false;
  bool _hostLocked = false;

  String _tr(String key) {
    const map = {
      'title': 'scanChat',
      'ask_host': 'askHost',
      'ask_desc': 'askDesc',
      'how_advice': 'howAdvice',
      'hint': 'typeAnswer',
      'send': 'send',
      'saved': 'savedKb',
      'bot': 'assistant',
      'you': 'you',
      'offline_advice': 'offlineAdvice',
      'no_pack': 'noPack',
      'want_advice': 'getAdvice',
    };
    return t(widget.lang, map[key] ?? key);
  }

  String _q(String key) {
    const qs = {
      'en': {
        'part': 'Which part is affected (leaves, stem, fruit, whole plant) — or for animals: age and which animals?',
        'signs': 'What signs do you see? (spots, yellow leaves, wilting, coughing, diarrhoea, weak…)',
        'duration': 'How long have you seen this? (days/weeks)',
        'spread': 'How many plants/animals are affected? Is it spreading?',
        'context': 'Any recent change? (rain, drought, new feed, new field, chemicals)',
        'tried': 'What have you already tried? (if nothing, type none)',
        'ready': 'Thanks. I locked this chat to {h} only (no other crops/animals). Type "advice" for guidance from published library + what we learned on this phone.',
        'learned': 'Saved on this phone for next {h} scan. Officers can review when online.',
        'from_memory': 'From earlier scans of this same item on this phone:',
      },
      'ny': {
        'part': 'Ndi gawo liti logwidwa (masamba, tsinde, zipatso) — kapena chiweto: zaka ndi zingati?',
        'signs': 'Mukuwona chiyani? (mawala, masamba achikasu, kuuma, kutsokomola…)',
        'duration': 'Mwawona kwanthawi yayitali bwanji?',
        'spread': 'Zili zingati zomwe zagwidwa? Zikufala?',
        'context': 'Pali kusintha? (mvula, chilala, chakudya chatsopano)',
        'tried': 'Mwayesa chiyani? (ngati palibe, lembani none)',
        'ready': 'Zikomo. Zokambirana zili pa {h} zokha. Lemani "advice" kuti mupeze uphungu.',
        'learned': 'Zasungidwa pa foni iyi pa {h}.',
        'from_memory': 'Kuchokera ku kuwunika kwakale kwa {h}:',
      },
      'fr': {
        'part': 'Quelle partie est touchée (feuilles, tige, fruit) — ou âge des animaux?',
        'signs': 'Quels signes voyez-vous?',
        'duration': 'Depuis combien de temps?',
        'spread': 'Combien sont touchés? Ça se propage?',
        'context': 'Changement récent (pluie, sécheresse, aliment)?',
        'tried': 'Qu\'avez-vous déjà essayé? (sinon: none)',
        'ready': 'Merci. Discussion verrouillée sur {h}. Tapez "advice" pour les conseils publiés.',
        'learned': 'Enregistré sur ce téléphone pour {h}.',
        'from_memory': 'D\'après les scans précédents de {h}:',
      },
      'sw': {
        'part': 'Sehemu gani imeathiriwa (majani, shina, matunda) — au umri wa mnyama?',
        'signs': 'Unaona ishara gani?',
        'duration': 'Umefanya muda gani?',
        'spread': 'Mimea/wanyama wangapi? Inaenea?',
        'context': 'Mabadiliko ya hivi karibuni (mvua, ukame, chakula)?',
        'tried': 'Umejaribu nini? (kama hakuna: none)',
        'ready': 'Asante. Mazungumzo yamefungwa kwa {h} pekee. Andika "advice".',
        'learned': 'Imehifadhiwa kwenye simu hii kwa {h}.',
        'from_memory': 'Kutoka uchunguzi wa awali wa {h}:',
      },
      'pt': {
        'part': 'Que parte está afetada (folhas, caule, fruto) — ou idade dos animais?',
        'signs': 'Que sinais vê?',
        'duration': 'Há quanto tempo?',
        'spread': 'Quantos estão afetados? Está a espalhar-se?',
        'context': 'Mudança recente (chuva, seca, ração)?',
        'tried': 'O que já tentou? (se nada: none)',
        'ready': 'Obrigado. Conversa bloqueada em {h}. Escreva "advice".',
        'learned': 'Guardado neste telefone para {h}.',
        'from_memory': 'De exames anteriores de {h}:',
      },
    };
    final lang = qs[widget.lang] ?? qs['en']!;
    return lang[key] ?? qs['en']![key]!;
  }

  bool _isAdviceRequest(String text) {
    final low = text.toLowerCase().trim();
    const keys = [
      'advice', 'give advice', 'help me', 'help', 'guidance', 'what should i do',
      'uphungu', 'thandizeni', 'thandizo', 'conseil', 'aide', 'ushauri', 'nisaidie', 'conselho', 'ajuda',
    ];
    return keys.any((k) => low == k || low.contains(k));
  }

  @override
  void initState() {
    super.initState();
    _confirmedHost = normalizeHost(widget.hostKey);
    _bootstrapMemory();
  }

  Future<void> _bootstrapMemory() async {
    final p = await SharedPreferences.getInstance();
    var host = normalizeHost(widget.hostKey);
    if (!mounted) return;
    List hist = await OfflineCache.historyForHost(widget.deviceId, host);
    try {
      final res = await http
          .get(Uri.parse(
              '$kApiBase/v1/scans/history?device_id=${Uri.encodeComponent(widget.deviceId)}&host_key=${Uri.encodeComponent(host)}&limit=10'))
          .timeout(const Duration(seconds: 5));
      if (res.statusCode == 200) {
        final data = jsonDecode(res.body) as Map;
        final items = data['items'] as List? ?? [];
        if (items.isNotEmpty) {
          final local = await OfflineCache.loadScanHistory();
          final byId = <String, Map>{};
          for (final e in [...local, ...items]) {
            if (e is Map) {
              final id = '${e['id'] ?? e['at'] ?? ''}';
              if (id.isNotEmpty) byId[id] = Map<String, dynamic>.from(e);
            }
          }
          await OfflineCache.saveScanHistory(byId.values.toList());
          hist = await OfflineCache.historyForHost(widget.deviceId, host);
        }
      }
    } catch (_) {}

    final memKey = 'scan_chat_${widget.deviceId}_$host';
    final prevDesc = p.getString('${memKey}_desc') ?? '';
    final known = p.getBool('${memKey}_known') ?? false;
    final localLearned = await LocalKb.forHost(host);
    final org = widget.organismType == 'livestock' ? t(widget.lang, 'animal') : t(widget.lang, 'crop');

    if ((known || hist.isNotEmpty || localLearned.isNotEmpty) && host.isNotEmpty && host != 'other') {
      _confirmedHost = host;
      _hostLocked = true;
      _description = prevDesc;
      _phase = 7;
      setState(() {
        _msgs.add({'role': 'bot', 'text': tf(widget.lang, 'rememberHost', {'h': hostLabel(host, widget.lang)})});
        if (hist.isNotEmpty || localLearned.isNotEmpty) {
          final buf = StringBuffer(_q('from_memory').replaceAll('{h}', hostLabel(host, widget.lang)));
          for (var i = 0; i < hist.length && i < 3; i++) {
            final e = hist[i] as Map;
            final note = '${e['farmer_description'] ?? ''}';
            if (note.isNotEmpty) buf.writeln('\n• ${'${e['at']}'.split('T').first}: $note');
          }
          for (var i = 0; i < localLearned.length && i < 2; i++) {
            final e = localLearned[localLearned.length - 1 - i];
            if (e is Map && '${e['signs']}'.isNotEmpty) buf.writeln('\n• learned: ${e['signs']}');
          }
          _msgs.add({'role': 'bot', 'text': buf.toString()});
        }
        if (prevDesc.isNotEmpty) {
          _msgs.add({'role': 'bot', 'text': tf(widget.lang, 'lastNotes', {'n': prevDesc})});
        }
        _msgs.add({'role': 'bot', 'text': _q('ready').replaceAll('{h}', hostLabel(host, widget.lang))});
      });
      return;
    }

    if (host.isNotEmpty && host != 'other') {
      _confirmedHost = host;
      setState(() {
        _phase = 0;
        final msg = widget.photoPath != null
            ? tf(widget.lang, 'identifyConfirm', {'h': hostLabel(host, widget.lang), 'o': org})
            : tf(widget.lang, 'identifyConfirm', {'h': hostLabel(host, widget.lang), 'o': org});
        _msgs.add({'role': 'bot', 'text': msg});
      });
    } else {
      setState(() {
        _phase = 0;
        _msgs.add({'role': 'bot', 'text': _tr('ask_host')});
      });
    }
  }

  Future<void> _rememberHost(String host, {String desc = ''}) async {
    final p = await SharedPreferences.getInstance();
    final h = normalizeHost(host);
    final memKey = 'scan_chat_${widget.deviceId}_$h';
    await p.setBool('${memKey}_known', true);
    if (desc.isNotEmpty) await p.setString('${memKey}_desc', desc);
  }

  Future<String> _loadAdvice() async {
    final host = normalizeHost(_confirmedHost.isNotEmpty ? _confirmedHost : widget.hostKey);
    // Never mix organisms: only this host
    final signsBlob = '${_answers['signs'] ?? ''} ${_description} ${_answers.values.join(' ')}';
    final fromMem = await LocalKb.similarAdvice(host, signsBlob);

    try {
      await OfflineCache.syncAll(kApiBase);
    } catch (_) {}

    try {
      final res = await http
          .post(
            Uri.parse('$kApiBase/v1/knowledge/chat'),
            headers: {'Content-Type': 'application/json'},
            body: jsonEncode({
              'message': signsBlob.isNotEmpty ? signsBlob : 'advice for $host',
              'language': widget.lang,
              'host_key': host,
              'description': signsBlob,
              'device_id': widget.deviceId,
            }),
          )
          .timeout(const Duration(seconds: 12));
      if (res.statusCode == 200) {
        final data = jsonDecode(res.body) as Map;
        var reply = '${data['reply'] ?? ''}';
        // Force host check
        final rh = normalizeHost('${data['host_key'] ?? host}');
        if (rh.isNotEmpty && rh != host && data['source'] == 'published_procedure') {
          reply = ''; // reject cross-host
        }
        if (reply.isNotEmpty) {
          reply = translateTo(reply, widget.lang);
          if (fromMem != null && fromMem.isNotEmpty) {
            reply = '${_q('from_memory').replaceAll('{h}', hostLabel(host, widget.lang))}\n${translateTo(fromMem, widget.lang)}\n\n$reply';
          }
          return reply;
        }
      }
    } catch (_) {}

    // Online diagnose locked to host
    try {
      final res = await http
          .post(
            Uri.parse('$kApiBase/v1/diagnosis/diagnose'),
            headers: {'Content-Type': 'application/json'},
            body: jsonEncode({
              'host_key': host,
              'organism_hint': isLivestockHost(host) ? 'livestock' : 'crop',
              'danger_signs_present': widget.dangerSigns,
              'symptom_keys': signsBlob.split(RegExp(r'[^a-zA-Z0-9]+')).where((w) => w.length > 3).toList(),
              'answers': _answers,
              'language': widget.lang,
              'device_id': widget.deviceId,
            }),
          )
          .timeout(const Duration(seconds: 12));
      if (res.statusCode == 200) {
        final data = jsonDecode(res.body) as Map;
        final primary = '${(data['messages'] as Map?)?['primary'] ?? data['outcome'] ?? ''}';
        final steps = data['procedure_steps'] as List? ?? [];
        final buf = StringBuffer();
        if (primary.isNotEmpty) buf.writeln(translateTo(primary, widget.lang));
        for (var i = 0; i < steps.length && i < 8; i++) {
          final s = steps[i];
          final text = s is Map ? '${s['text'] ?? s}' : '$s';
          buf.writeln('${i + 1}. ${translateTo(text, widget.lang)}');
        }
        final out = buf.toString().trim();
        if (out.isNotEmpty) return out;
      }
    } catch (_) {}

    final procs = await OfflineCache.loadProcedures();
    final keys = signsBlob.toLowerCase().split(RegExp(r'[^a-z0-9_]+')).where((w) => w.length > 3).toList();
    final matched = OfflineCache.matchPublished(procs, host, keys);
    if (matched != null) {
      final r = OfflineCache.resultFromProcedure(matched, widget.lang);
      final primary = '${(r['messages'] as Map?)?['primary'] ?? ''}';
      final steps = r['procedure_steps'] as List? ?? [];
      final buf = StringBuffer('${_tr('offline_advice')}: ${translateTo(primary, widget.lang)}\n');
      for (var i = 0; i < steps.length && i < 8; i++) {
        final s = steps[i];
        final text = s is Map ? '${s['text'] ?? s}' : '$s';
        buf.writeln('${i + 1}. ${translateTo(text, widget.lang)}');
      }
      if (fromMem != null && fromMem.isNotEmpty) {
        return '${_q('from_memory').replaceAll('{h}', hostLabel(host, widget.lang))}\n${translateTo(fromMem, widget.lang)}\n\n${buf.toString().trim()}';
      }
      return buf.toString().trim();
    }
    if (fromMem != null && fromMem.isNotEmpty) {
      return '${_q('from_memory').replaceAll('{h}', hostLabel(host, widget.lang))}\n${translateTo(fromMem, widget.lang)}\n\n${_tr('no_pack')}';
    }
    return _tr('no_pack') + '\n\n' + tf(widget.lang, 'noPackTip', {'h': host});
  }

  Future<void> _saveEpisode(String advice) async {
    final host = normalizeHost(_confirmedHost.isNotEmpty ? _confirmedHost : widget.hostKey);
    final episode = {
      'id': 'local-${DateTime.now().millisecondsSinceEpoch}',
      'at': DateTime.now().toUtc().toIso8601String(),
      'device_id': widget.deviceId,
      'host_key': host,
      'organism_type': isLivestockHost(host) ? 'livestock' : 'crop',
      'farmer_description': _description,
      'signs': _answers['signs'] ?? '',
      'answers': _answers,
      'condition_label': _answers['signs'] ?? host,
      'advice_summary': advice.length > 500 ? advice.substring(0, 500) : advice,
      'outcome': 'chat_advice',
      'language': widget.lang,
    };
    await OfflineCache.appendScanEpisode(episode);
    await LocalKb.learn(host: host, answers: _answers, advice: advice);
    await _rememberHost(host, desc: _description.isNotEmpty ? _description : '${_answers['signs']}');
    try {
      await http
          .post(
            Uri.parse('$kApiBase/v1/scans/record'),
            headers: {'Content-Type': 'application/json'},
            body: jsonEncode(episode),
          )
          .timeout(const Duration(seconds: 8));
    } catch (_) {}
    try {
      await http
          .post(
            Uri.parse('$kApiBase/v1/knowledge/contribute'),
            headers: {'Content-Type': 'application/json'},
            body: jsonEncode({
              'device_id': widget.deviceId,
              'host_key': host,
              'organism_type': episode['organism_type'],
              'farmer_description': _description,
              'signs_reported': _answers,
              'language': widget.lang,
            }),
          )
          .timeout(const Duration(seconds: 8));
    } catch (_) {}
  }

  Future<void> _send() async {
    final text = _ctrl.text.trim();
    if (text.isEmpty || _busy) return;
    _ctrl.clear();
    setState(() {
      _msgs.add({'role': 'you', 'text': text});
      _busy = true;
    });

    // Advice anytime after host locked
    if (_hostLocked && _isAdviceRequest(text)) {
      final advice = await _loadAdvice();
      if (!mounted) return;
      await _saveEpisode(advice);
      setState(() {
        _msgs.add({'role': 'bot', 'text': advice});
        _msgs.add({'role': 'bot', 'text': _q('learned').replaceAll('{h}', hostLabel(_confirmedHost, widget.lang))});
        _adviceGiven = true;
        _busy = false;
      });
      return;
    }

    // Phase 0: confirm host — lock forever for this chat
    if (_phase == 0) {
      final low = text.toLowerCase().trim();
      final yes = ['yes', 'y', 'correct', 'ok', 'ee', 'inde', 'ndiyo', 'oui', 'sim', 's'].contains(low);
      if (!yes) {
        final h = normalizeHost(text);
        // Reject cross-type if widget fixed organism
        if (widget.organismType == 'crop' && isLivestockHost(h)) {
          setState(() {
            _msgs.add({'role': 'bot', 'text': _tr('ask_host')});
            _busy = false;
          });
          return;
        }
        if (widget.organismType == 'livestock' && !isLivestockHost(h) && h.isNotEmpty) {
          // allow if they type livestock name; if crop name while livestock mode warn
          if (cropHosts.contains(h)) {
            setState(() {
              _msgs.add({'role': 'bot', 'text': _tr('ask_host')});
              _busy = false;
            });
            return;
          }
        }
        _confirmedHost = h;
      }
      _hostLocked = true;
      await _rememberHost(_confirmedHost);
      setState(() {
        _phase = 1;
        _msgs.add({'role': 'bot', 'text': _q('part')});
        _busy = false;
      });
      return;
    }

    if (_phase == 1) {
      _answers['part'] = text;
      setState(() {
        _phase = 2;
        _msgs.add({'role': 'bot', 'text': _q('signs')});
        _busy = false;
      });
      return;
    }
    if (_phase == 2) {
      _answers['signs'] = text;
      _description = text;
      setState(() {
        _phase = 3;
        _msgs.add({'role': 'bot', 'text': _q('duration')});
        _busy = false;
      });
      return;
    }
    if (_phase == 3) {
      _answers['duration'] = text;
      setState(() {
        _phase = 4;
        _msgs.add({'role': 'bot', 'text': _q('spread')});
        _busy = false;
      });
      return;
    }
    if (_phase == 4) {
      _answers['spread'] = text;
      setState(() {
        _phase = 5;
        _msgs.add({'role': 'bot', 'text': _q('context')});
        _busy = false;
      });
      return;
    }
    if (_phase == 5) {
      _answers['context'] = text;
      setState(() {
        _phase = 6;
        _msgs.add({'role': 'bot', 'text': _q('tried')});
        _busy = false;
      });
      return;
    }
    if (_phase == 6) {
      _answers['tried'] = text;
      _description = _answers.values.join('; ');
      await _rememberHost(_confirmedHost, desc: _description);
      // Count as scan as soon as interview completes (dashboard total scans)
      await _saveEpisode('(interview complete — advice pending)');
      setState(() {
        _phase = 7;
        _msgs.add({'role': 'bot', 'text': _q('ready').replaceAll('{h}', hostLabel(_confirmedHost, widget.lang))});
        _busy = false;
      });
      return;
    }

    // Phase 7+: questions about this host's published library OR advice
    _description = '$_description; $text';
    _answers['extra'] = '${_answers['extra'] ?? ''} $text';
    await _rememberHost(_confirmedHost, desc: _description);
    if (_isAdviceRequest(text)) {
      final advice = await _loadAdvice();
      if (!mounted) return;
      await _saveEpisode(advice);
      setState(() {
        _msgs.add({'role': 'bot', 'text': advice});
        _msgs.add({'role': 'bot', 'text': _q('learned').replaceAll('{h}', hostLabel(_confirmedHost, widget.lang))});
        _adviceGiven = true;
        _busy = false;
      });
      return;
    }
    // Ask knowledge base (e.g. types of diseases of tomatoes)
    final kb = await _askLibrary(text);
    if (!mounted) return;
    setState(() {
      _msgs.add({'role': 'bot', 'text': kb['text'] ?? ''});
      final imgs = kb['images'] as List? ?? [];
      for (final u in imgs) {
        if (u is String && u.isNotEmpty) {
          _msgs.add({'role': 'bot', 'text': '', 'image_url': u});
        }
      }
      _busy = false;
    });
  }

  Future<Map<String, dynamic>> _askLibrary(String question) async {
    final host = normalizeHost(_confirmedHost.isNotEmpty ? _confirmedHost : widget.hostKey);
    try {
      final res = await http
          .post(
            Uri.parse('$kApiBase/v1/knowledge/chat'),
            headers: {'Content-Type': 'application/json', 'Accept': 'application/json'},
            body: jsonEncode({
              'message': question,
              'language': widget.lang,
              'host_key': host,
              'description': _description,
              'device_id': widget.deviceId,
            }),
          )
          .timeout(const Duration(seconds: 12));
      if (res.statusCode == 200) {
        final data = jsonDecode(res.body) as Map;
        var reply = '${data['reply'] ?? ''}';
        reply = translateTo(reply, widget.lang);
        final images = <String>[];
        final imgs = data['images'] as List? ?? [];
        for (final im in imgs) {
          if (im is Map) {
            var url = '${im['image_url'] ?? ''}';
            if (url.startsWith('/')) url = '$kApiBase$url';
            if (url.isNotEmpty) images.add(url);
          }
        }
        // Offline fallback catalog if empty
        if (reply.isEmpty || data['source'] == 'none') {
          final offline = await _offlineCatalog(host, question: question);
          return offline;
        }
        return {'text': reply, 'images': images};
      }
    } catch (_) {}
    return await _offlineCorpusAnswer(host, question);
  }

  
  Future<Map<String, dynamic>> _offlineCorpusAnswer(String host, String question) async {
    final procs = await OfflineCache.loadProcedures();
    final q = question.toLowerCase();
    final tokens = q.split(RegExp(r'[^a-z0-9]+')).where((w) => w.length > 2).toSet();
    final hk = normalizeHost(host);
    final scored = <Map<String, dynamic>>[];
    for (final p in procs) {
      if (p is! Map) continue;
      final st = '${p['status']}';
      if (st.isNotEmpty && st != 'published') continue;
      final ph = normalizeHost('${p['host_key']}');
      final title = p['title'];
      final name = title is Map ? (title[widget.lang] ?? title['en'] ?? '') : '$title';
      final full = '${p['full_text'] ?? ''}';
      final steps = p['steps'];
      final stepList = steps is Map
          ? ((steps[widget.lang] ?? steps['en'] ?? []) as List)
          : (steps is List ? steps : []);
      final blob = ('$name $ph $full ${stepList.join(' ')}').toLowerCase();
      var score = 0;
      for (final tok in tokens) {
        if (blob.contains(tok)) score += 2;
      }
      if (hk.isNotEmpty && ph == hk) score += 8;
      if (score > 0) {
        scored.add({
          'score': score,
          'name': name,
          'host': ph,
          'full': full,
          'steps': stepList,
        });
      }
    }
    scored.sort((a, b) => (b['score'] as int).compareTo(a['score'] as int));
    if (scored.isEmpty) {
      return await _offlineCatalog(host, question: question);
    }
    final buf = StringBuffer();
    buf.writeln(t(widget.lang, 'fromBook'));
    var i = 0;
    for (final d in scored.take(5)) {
      i++;
      buf.writeln('$i. ${d['name']} (${d['host']})');
      final full = '${d['full']}';
      if (full.isNotEmpty && tokens.isNotEmpty) {
        final sents = full.split(RegExp(r'[.\n]+'));
        var hits = 0;
        for (final s in sents) {
          final low = s.toLowerCase();
          if (tokens.any((tok) => tok.length > 3 && low.contains(tok))) {
            buf.writeln('   • ${s.trim()}');
            hits++;
            if (hits >= 3) break;
          }
        }
      }
      final steps = d['steps'];
      if (steps is List && steps.isNotEmpty) {
        buf.writeln('   ${t(widget.lang, 'treatment')}: ${steps.take(4).join('; ')}');
      }
    }
    buf.writeln(t(widget.lang, 'askExpertSafe'));
    return {'text': buf.toString(), 'images': <String>[]};
  }

Future<Map<String, dynamic>> _offlineCatalog(String host, {String question = ''}) async {
    final procs = await OfflineCache.loadProcedures();
    final lib = await OfflineCache.loadLibrary();
    final hk = normalizeHost(host);
    final qtokens = question
        .toLowerCase()
        .split(RegExp(r'[^a-z0-9]+'))
        .where((w) => w.length > 3)
        .toSet();
    final buf = StringBuffer('Published knowledge for $hk:\n');
    var n = 0;
    for (final p in procs) {
      if (p is! Map) continue;
      if (normalizeHost('${p['host_key']}') != hk) continue;
      final st = '${p['status']}';
      if (st.isNotEmpty && st != 'published') continue;
      final title = p['title'];
      final name = title is Map ? (title[widget.lang] ?? title['en'] ?? 'condition') : '$title';
      final full = '${p['full_text'] ?? ''}';
      n++;
      buf.writeln('$n. $name');
      if (full.isNotEmpty && qtokens.isNotEmpty) {
        final sents = full.split(RegExp(r'[.\n]+'));
        var hits = 0;
        for (final s in sents) {
          final low = s.toLowerCase();
          if (qtokens.any((t) => low.contains(t))) {
            buf.writeln('   ${s.trim()}');
            hits++;
            if (hits >= 3) break;
          }
        }
      }
    }
    for (final it in lib) {
      if (it is! Map) continue;
      if (normalizeHost('${it['host_key']}') != hk) continue;
      final label = '${it['condition_label'] ?? it['title'] ?? it['filename'] ?? ''}';
      final et = '${it['extracted_text'] ?? ''}';
      if (label.isEmpty && et.isEmpty) continue;
      n++;
      buf.writeln('$n. ${label.isNotEmpty ? label : 'Library document'}');
      if (et.isNotEmpty && qtokens.isNotEmpty) {
        final sents = et.split(RegExp(r'[.\n]+'));
        var hits = 0;
        for (final s in sents) {
          final low = s.toLowerCase();
          if (qtokens.any((t) => low.contains(t))) {
            buf.writeln('   ${s.trim()}');
            hits++;
            if (hits >= 2) break;
          }
        }
      }
    }
    if (n == 0) {
      return {'text': _tr('no_pack'), 'images': <String>[]};
    }
    return {'text': buf.toString(), 'images': <String>[]};
  }


  @override
  Widget build(BuildContext context) {
    return Scaffold(
      appBar: AppBar(
        title: Text('${_tr('title')}${_hostLocked ? ' · ${hostLabel(_confirmedHost, widget.lang)}' : ''}'),
      ),
      body: Column(
        children: [
          if (_confirmedHost.isNotEmpty)
            Container(
              width: double.infinity,
              color: C.green.withValues(alpha: 0.12),
              padding: const EdgeInsets.symmetric(horizontal: 12, vertical: 8),
              child: Text(
                '${hostLabel(_confirmedHost, widget.lang)} · ${isLivestockHost(_confirmedHost) ? t(widget.lang, 'animal') : t(widget.lang, 'crop')}',
                style: const TextStyle(fontWeight: FontWeight.w700, fontSize: 13),
              ),
            ),
          Expanded(
            child: ListView.builder(
              padding: const EdgeInsets.all(12),
              itemCount: _msgs.length,
              itemBuilder: (_, i) {
                final m = _msgs[i];
                final bot = m['role'] == 'bot';
                final img = m['image_url'] ?? '';
                return Align(
                  alignment: bot ? Alignment.centerLeft : Alignment.centerRight,
                  child: Container(
                    margin: const EdgeInsets.only(bottom: 8),
                    padding: const EdgeInsets.all(12),
                    constraints: BoxConstraints(maxWidth: MediaQuery.of(context).size.width * 0.85),
                    decoration: BoxDecoration(
                      color: bot ? Colors.white : C.green.withValues(alpha: 0.15),
                      borderRadius: BorderRadius.circular(14),
                      border: Border.all(color: const Color(0xFFE5E7EB)),
                    ),
                    child: Column(
                      crossAxisAlignment: CrossAxisAlignment.start,
                      children: [
                        if ((m['text'] ?? '').isNotEmpty)
                          Text(m['text'] ?? '', style: const TextStyle(height: 1.35)),
                        if (img.isNotEmpty) ...[
                          const SizedBox(height: 8),
                          ClipRRect(
                            borderRadius: BorderRadius.circular(10),
                            child: Image.network(
                              img,
                              height: 160,
                              width: double.infinity,
                              fit: BoxFit.cover,
                              errorBuilder: (_, __, ___) => const Text('Image unavailable offline'),
                            ),
                          ),
                        ],
                      ],
                    ),
                  ),
                );
              },
            ),
          ),
          Padding(
            padding: const EdgeInsets.fromLTRB(12, 0, 12, 12),
            child: Row(
              children: [
                Expanded(
                  child: TextField(
                    controller: _ctrl,
                    decoration: InputDecoration(
                      hintText: _tr('hint'),
                      border: OutlineInputBorder(borderRadius: BorderRadius.circular(12)),
                      isDense: true,
                    ),
                    onSubmitted: (_) => _send(),
                  ),
                ),
                const SizedBox(width: 8),
                IconButton.filled(
                  onPressed: _busy ? null : _send,
                  icon: const Icon(Icons.send),
                ),
              ],
            ),
          ),
          Padding(
            padding: const EdgeInsets.fromLTRB(12, 0, 12, 16),
            child: SizedBox(
              width: double.infinity,
              child: FilledButton(
                onPressed: _busy || !_hostLocked
                    ? null
                    : () async {
                        setState(() => _busy = true);
                        final advice = await _loadAdvice();
                        if (!mounted) return;
                        await _saveEpisode(advice);
                        setState(() {
                          _msgs.add({'role': 'bot', 'text': advice});
                          _msgs.add({
                            'role': 'bot',
                            'text': _q('learned').replaceAll('{h}', hostLabel(_confirmedHost, widget.lang))
                          });
                          _adviceGiven = true;
                          _busy = false;
                        });
                      },
                child: Text(_tr('want_advice')),
              ),
            ),
          ),
        ],
      ),
    );
  }
}

