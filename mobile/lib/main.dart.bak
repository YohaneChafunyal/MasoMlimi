                      width: 74, height: 74,
                      decoration: BoxDecoration(shape: BoxShape.circle, color: C.greenDark, border: Border.all(color: C.greenSoft, width: 5)),
                      child: const Icon(Icons.camera_alt, color: Colors.white, size: 30),
