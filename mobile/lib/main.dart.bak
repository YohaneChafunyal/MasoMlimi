const moreCropKeys = ['maize', 'cassava', 'tomato', 'beans', 'groundnuts', 'rice', 'sorghum', 'millet', 'sweet_potato', 'banana', 'onion', 'cabbage'];
const moreAnimalKeys = ['chicken', 'goats', 'cattle', 'pigs', 'sheep', 'ducks'];





/// File-backed offline store (survives app restarts; never wiped by empty API).
class OfflineCache {
  static Future<Directory> _dir() async {
    final root = await getApplicationDocumentsDirectory();
    final d = Directory('${root.path}/masomlimi_offline');
    if (!await d.exists()) await d.create(recursive: true);
    return d;
  }

  static Future<File> _file(String name) async {
    final d = await _dir();
    return File('${d.path}/$name');
  }

  static Future<void> _writeList(String name, List items) async {
    if (items.isEmpty) return; // never wipe good data with empty
    final f = await _file(name);
    await f.writeAsString(jsonEncode(items), flush: true);
    // mirror small prefs key for quick presence check
    final p = await SharedPreferences.getInstance();
    await p.setString('has_$name', '1');
    await p.setString('at_$name', DateTime.now().toIso8601String());
  }

  static Future<List> _readList(String name) async {
    try {
      final f = await _file(name);
      if (!await f.exists()) {
        // migrate from old SharedPreferences if any
        final p = await SharedPreferences.getInstance();
        final legacy = p.getString('cache_$name') ?? p.getString(name);
        if (legacy != null && legacy.isNotEmpty) {
          final data = jsonDecode(legacy);
          if (data is List && data.isNotEmpty) {
            await _writeList(name, data);
            return data;
          }
        }
        return [];
      }
      final data = jsonDecode(await f.readAsString());
      return data is List ? data : [];
    } catch (_) {
      return [];
    }
  }

  static Future<void> saveProcedures(List items) async => _writeList('procedures.json', items);
  static Future<List> loadProcedures() async => _readList('procedures.json');

  static Future<void> saveLibrary(List items) async => _writeList('library.json', items);
  static Future<List> loadLibrary() async => _readList('library.json');

  static Future<void> saveExperts(List items) async => _writeList('experts.json', items);
  static Future<List> loadExperts() async => _readList('experts.json');

  static Future<void> saveAlerts(List items) async => _writeList('alerts.json', items);
  static Future<List> loadAlerts() async => _readList('alerts.json');

  static Future<void> saveScanHistory(List items) async => _writeList('scan_history.json', items);
  static Future<List> loadScanHistory() async => _readList('scan_history.json');

  static Future<void> appendScanEpisode(Map episode) async {
    final all = List.from(await loadScanHistory());
    all.add(episode);
    // keep last 200
    final trimmed = all.length > 200 ? all.sublist(all.length - 200) : all;
    await saveScanHistory(trimmed);
  }

  static Future<List> historyForHost(String deviceId, String hostKey) async {
    final hk = normalizeHost(hostKey);
    final all = await loadScanHistory();
    return all.where((e) {
      if (e is! Map) return false;
      if (deviceId.isNotEmpty && '${e['device_id']}' != deviceId) return false;
      return normalizeHost('${e['host_key']}') == hk;
    }).toList().reversed.toList();
  }

  static Future<void> saveChat(String deviceId, String expertId, List messages) async {
    final sorted = dedupeMessages(messages);
    final safe = '${deviceId}_$expertId'.replaceAll(RegExp(r'[^a-zA-Z0-9_-]'), '_');
    await _writeList('chat_$safe.json', sorted);
  }

  static Future<List> loadChat(String deviceId, String expertId) async {
    final safe = '${deviceId}_$expertId'.replaceAll(RegExp(r'[^a-zA-Z0-9_-]'), '_');
    return _sortMessages(await _readList('chat_$safe.json'));
  }

  static List _sortMessages(List messages) {
    final copy = List.from(messages);
    copy.sort((a, b) {
      final at = a is Map ? '${a['at'] ?? ''}' : '';
      final bt = b is Map ? '${b['at'] ?? ''}' : '';
      final c = at.compareTo(bt);
      if (c != 0) return c;
      return '${a is Map ? a['id'] : ''}'.compareTo('${b is Map ? b['id'] : ''}');
    });
    return copy;
  }

  static Future<void> appendOutgoingChat(String deviceId, String expertId, Map msg) async {
    final list = await loadChat(deviceId, expertId);
    final id = '${msg['id'] ?? ''}';
    if (id.isNotEmpty) {
      list.removeWhere((m) => m is Map && '${m['id']}' == id);
    }
    list.add(msg);
    await saveChat(deviceId, expertId, list);
  }

  static Future<List> loadOutbox() async => _readList('outbox.json');

  static Future<void> saveOutbox(List items) async {
    // outbox MAY be empty after successful flush
    final f = await _file('outbox.json');
    await f.writeAsString(jsonEncode(items), flush: true);
  }

  static Future<void> enqueueOutbox(Map item) async {
    final box = await loadOutbox();
    item['queued_at'] = item['queued_at'] ?? DateTime.now().toIso8601String();
    box.add(item);
    box.sort((a, b) {
      final at = a is Map ? '${a['queued_at'] ?? ''}' : '';
      final bt = b is Map ? '${b['queued_at'] ?? ''}' : '';
      return at.compareTo(bt);
    });
    final f = await _file('outbox.json');
    await f.writeAsString(jsonEncode(box), flush: true);
  }

  static bool _outboxFlushing = false;

  static Future<int> flushOutbox(String apiBase) async {
    if (_outboxFlushing) return 0;
    _outboxFlushing = true;
    try {
    final box = await loadOutbox();
    if (box.isEmpty) return 0;
    final remain = <dynamic>[];
    var sent = 0;
    for (final raw in box) {
      if (raw is! Map) continue;
      final item = Map<String, dynamic>.from(raw);
      try {
        final type = '${item['type'] ?? 'text'}';
        if (type == 'audio_note' && item['file_path'] != null) {
          final path = '${item['file_path']}';
          final file = File(path);
          if (!await file.exists()) {
            remain.add(item);
            continue;
          }
          final len = await file.length();
          if (len < 500) {
            // drop empty recordings
            sent++;
            continue;
          }
          final req = http.MultipartRequest('POST', Uri.parse('$apiBase/v1/chat/voice'));
          req.fields['device_id'] = '${item['device_id']}';
          req.fields['expert_id'] = '${item['expert_id']}';
          req.fields['sender'] = '${item['sender'] ?? 'farmer'}';
          req.fields['client_id'] = '${item['client_id'] ?? item['id'] ?? ''}';
          final fname = path.split(Platform.pathSeparator).last;
          req.files.add(await http.MultipartFile.fromPath('audio', path, filename: fname));
          final streamed = await req.send().timeout(const Duration(seconds: 45));
          final body = await streamed.stream.bytesToString();
          if (streamed.statusCode >= 200 && streamed.statusCode < 300) {
            // Keep a playable copy named like the server file
            try {
              final match = RegExp(r'\[voice_note:([^\]]+)\]').firstMatch(body);
              if (match != null) {
                final name = match.group(1)!;
                final dir = await getApplicationDocumentsDirectory();
                final cache = File('${dir.path}/masomlimi_offline/voice_cache/$name');
                await cache.parent.create(recursive: true);
                await file.copy(cache.path);
                final prefs = await SharedPreferences.getInstance();
                await prefs.setString('voice_local_$name', cache.path);
              }
            } catch (_) {}
            sent++;
            continue;
          }
          remain.add(item);
        } else {
          final res = await http
              .post(
                Uri.parse('$apiBase/v1/chat'),
                headers: {'Content-Type': 'application/json'},
                body: jsonEncode({
                  'device_id': item['device_id'],
                  'expert_id': item['expert_id'],
                  'text': item['text'],
                  'sender': item['sender'] ?? 'farmer',
                  'msg_type': item['msg_type'] ?? 'text',
                }),
              )
              .timeout(const Duration(seconds: 15));
          if (res.statusCode >= 200 && res.statusCode < 300) {
            sent++;
            continue;
          }
          remain.add(item);
        }
      } catch (_) {
        remain.add(item);
      }
    }
    await saveOutbox(remain);
    return sent;
    } finally {
      _outboxFlushing = false;
    }
  }

  static Future<void> saveKbMemory(List items) async => _writeList('kb_memory.json', items);
  static Future<List> loadKbMemory() async => _readList('kb_memory.json');

  static Future<void> enqueueContribution(Map item) async {
    final box = await _readList('contrib_outbox.json');
    item['queued_at'] = DateTime.now().toIso8601String();
    box.add(item);
    final f = await _file('contrib_outbox.json');
    await f.writeAsString(jsonEncode(box), flush: true);
  }

  static Future<int> flushContributions(String apiBase) async {
    final f = await _file('contrib_outbox.json');
    List box = [];
    if (await f.exists()) {
      try {
        final data = jsonDecode(await f.readAsString());
        if (data is List) box = data;
      } catch (_) {}
    }
    if (box.isEmpty) return 0;
    final remain = <dynamic>[];
    var sent = 0;
    for (final raw in box) {
      if (raw is! Map) continue;
      try {
        final res = await http
            .post(
              Uri.parse('$apiBase/v1/knowledge/contribute'),
              headers: {'Content-Type': 'application/json'},
              body: jsonEncode(raw),
            )
            .timeout(const Duration(seconds: 15));
        if (res.statusCode >= 200 && res.statusCode < 300) {
          sent++;
        } else {
          remain.add(raw);
        }
      } catch (_) {
        remain.add(raw);
      }
    }
    await f.writeAsString(jsonEncode(remain), flush: true);
    return sent;
  }

  static Future<Map<String, int>> packSummary() async {
    final procs = await loadProcedures();
    final lib = await loadLibrary();
    final experts = await loadExperts();
    final alerts = await loadAlerts();
    return {
      'procedures': procs.length,
      'library': lib.length,
      'experts': experts.length,
      'alerts': alerts.length,
    };
  }

  static Future<void> syncAll(String apiBase) async {
    try {
      await flushOutbox(apiBase);
    } catch (_) {}
    try {
      // Always replace local packs with server published list (including empty after deletes)
      final pr = await http.get(Uri.parse('$apiBase/v1/procedures')).timeout(const Duration(seconds: 8));
      if (pr.statusCode == 200) {
        final data = jsonDecode(pr.body);
        final items = data is Map ? (data['items'] as List? ?? []) : (data is List ? data : []);
        final published = items
            .where((p) => p is Map && ('${p['status']}' == 'published' || '${p['status']}' == ''))
            .where((p) => p is Map && '${p['status']}' != 'draft')
            .toList();
        // Prefer explicit published only
        final onlyPub = items.where((p) => p is Map && '${p['status']}' == 'published').toList();
        await saveProcedures(onlyPub);
      }
    } catch (_) {}
    try {
      final lib = await http.get(Uri.parse('$apiBase/v1/library')).timeout(const Duration(seconds: 8));
      if (lib.statusCode == 200) {
        final data = jsonDecode(lib.body);
        final items = data is Map ? (data['items'] as List? ?? []) : [];
        if (items.isNotEmpty) await saveLibrary(items);
      }
    } catch (_) {}
    try {
      for (final q in ['district=all', 'district=Dowa', 'district=Lilongwe', '']) {
        final url = q.isEmpty ? '$apiBase/v1/experts/' : '$apiBase/v1/experts/?country=MW&$q';
        final res = await http.get(Uri.parse(url)).timeout(const Duration(seconds: 6));
        if (res.statusCode == 200) {
          final data = jsonDecode(res.body);
          if (data is List && data.isNotEmpty) {
            await saveExperts(data);
            break;
          }
        }
      }
    } catch (_) {}
    try {
      // device scan history (second-visit memory across reinstall if server has it)
      // filled when device_id known from caller — optional no-op here
    } catch (_) {}
    try {
      final a = await http.get(Uri.parse('$apiBase/v1/alerts?district=Lilongwe')).timeout(const Duration(seconds: 6));
      if (a.statusCode == 200) {
        final data = jsonDecode(a.body);
        final items = data is Map ? (data['items'] as List? ?? []) : [];
        if (items.isNotEmpty) await saveAlerts(items);
      }
    } catch (_) {}
    try {
      await flushContributions(apiBase);
    } catch (_) {}
    try {
      final kb = await http.get(Uri.parse('$apiBase/v1/sync/knowledge')).timeout(const Duration(seconds: 8));
      if (kb.statusCode == 200) {
        final data = jsonDecode(kb.body) as Map;
        final mem = data['memory'] as List? ?? [];
        if (mem.isNotEmpty) await saveKbMemory(mem);
        final procs = data['procedures'] as List? ?? [];
        if (procs.isNotEmpty) await saveProcedures(procs);
      }
    } catch (_) {}
  }

  /// One bubble per logical message (stops local+server doubles).
  static List dedupeMessages(List messages) {
    final sorted = _sortMessages(messages);
    // Pass 1: if any server voice exists, drop all local voice placeholders
    final hasServerVoice = sorted.any((m) =>
        m is Map && '${m['text']}'.contains('[voice_note:'));
    final filtered = <dynamic>[];
    for (final m in sorted) {
      if (m is! Map) continue;
      final text = '${m['text'] ?? ''}';
      final type = '${m['type'] ?? ''}';
      final id = '${m['id'] ?? ''}';
      final isLocalVoice = id.startsWith('local-') &&
          (type == 'audio_note' || text.contains('[Voice note]'));
      if (hasServerVoice && isLocalVoice) continue;
      filtered.add(m);
    }
    // Pass 2: unique by id, voice file, or sender+text
    final out = <dynamic>[];
    final seenIds = <String>{};
    final seenVoiceFiles = <String>{};
    final seenText = <String>{};
    for (final m in filtered) {
      if (m is! Map) continue;
      final id = '${m['id'] ?? ''}';
      if (id.isNotEmpty && !id.startsWith('local-')) {
        if (seenIds.contains(id)) continue;
        seenIds.add(id);
      }
      final text = '${m['text'] ?? ''}';
      final type = '${m['type'] ?? ''}';
      final isVoice = type == 'audio_note' || text.contains('[voice_note:') || text.contains('[Voice note]');
      if (isVoice) {
        String vkey = '${m['local_path'] ?? ''}';
        final match = RegExp(r'\[voice_note:([^\]]+)\]').firstMatch(text);
        if (match != null) vkey = match.group(1) ?? text;
        final cid = '${m['client_id'] ?? ''}';
        final at = DateTime.tryParse('${m['at'] ?? ''}') ?? DateTime.now();
        // 2-minute bucket collapses double sends
        final timeBucket = '${m['sender']}|vn|${at.millisecondsSinceEpoch ~/ 120000}';
        if (cid.isNotEmpty && seenVoiceFiles.contains('cid:$cid')) continue;
        if (vkey.isNotEmpty && seenVoiceFiles.contains(vkey)) continue;
        if (seenVoiceFiles.contains(timeBucket)) continue;
        if (cid.isNotEmpty) seenVoiceFiles.add('cid:$cid');
        if (vkey.isNotEmpty) seenVoiceFiles.add(vkey);
        seenVoiceFiles.add(timeBucket);
        out.add(m);
        continue;
      }
      final tkey = '${m['sender']}|$text';
      if (text.isNotEmpty) {
        if (seenText.contains(tkey)) {
          if (id.startsWith('local-')) continue;
          // replace local with server
          final idx = out.indexWhere((x) =>
              x is Map && '${x['sender']}|${x['text']}' == tkey && '${x['id']}'.startsWith('local-'));
          if (idx >= 0) out[idx] = m;
          continue;
        }
        seenText.add(tkey);
      }
      if (id.startsWith('local-') && id.isNotEmpty) {
        if (seenIds.contains(id)) continue;
        seenIds.add(id);
      }
      out.add(m);
    }
    return _sortMessages(out);
  }

  static Map<String, dynamic>? matchPublished(List procs, String hostKey, List<String> symptomKeys) {
    final hk = normalizeHost(hostKey);
    final matches = procs.where((p) {
      if (p is! Map) return false;
      final st = '${p['status']}'.toLowerCase();
      if (st.isNotEmpty && st != 'published' && st != 'null' && st != '') {
        // offline packs may omit status when only published were synced
        if (st != 'published') return false;
      }
      return normalizeHost('${p['host_key']}') == hk;
    }).toList();
    if (matches.isEmpty) return null;
    matches.sort((a, b) {
      int score(Map p) {
        final blob = '${p['title']} ${p['steps']} ${p['prevention_steps']}'.toLowerCase();
        var s = 0;
        for (final k in symptomKeys) {
          if (blob.contains(k.replaceAll('_', ' ')) || blob.contains(k)) s++;
        }
        return s;
      }
      return score(b as Map).compareTo(score(a as Map));
    });
    return Map<String, dynamic>.from(matches.first as Map);
  }

  static Map<String, dynamic> resultFromProcedure(Map p, String lang) {
    final title = p['title'];
    String name = 'Guidance';
    if (title is Map) {
      name = '${title[lang] ?? title['en'] ?? title.values.first}';
    }
    final stepsRaw = p['steps'];
    List stepTexts = [];
    if (stepsRaw is Map) {
      final v = stepsRaw[lang] ?? stepsRaw['en'] ?? (stepsRaw.values.isNotEmpty ? stepsRaw.values.first : []);
      if (v is List) stepTexts = v;
    }
    final prevRaw = p['prevention_steps'];
    List prevTexts = [];
    if (prevRaw is Map) {
      final v = prevRaw[lang] ?? prevRaw['en'] ?? [];
      if (v is List) prevTexts = v;
    }
    return {
      'outcome': 'published_guidance',
      'result_color': 'green',
      'confidence_band': 'medium',
      'condition': {'id': p['id'], 'common_name': name, 'is_dangerous': false},
      'procedure_steps': stepTexts.map((s) => {'type': 'published', 'text': '$s'}).toList(),
      'prevention_steps': prevTexts.map((s) => {'type': 'prevention', 'text': '$s'}).toList(),
      'products': p['products'] is List ? p['products'] : [],
      'messages': {
        'primary': name,
        'published_note': 'From saved expert guidance (offline pack).',
        'ask_expert_note': 'Ask a verified officer if unsure.',
      },
      'referral_required': false,
      'from_published_library': true,
      'from_offline_cache': true,
      'procedure_id': p['id'],
    };
  }
}




