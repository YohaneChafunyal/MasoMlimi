# REQUIRED in production: long random value (openssl rand -hex 32). Without it expert endpoints are DENIED.
MASOMLIMI_API_KEY=
# Only on a developer laptop: allow expert endpoints with no key
# MASOMLIMI_ALLOW_OPEN=1
# Secret used to sign content packs (use a different value from the API key)
MASOMLIMI_PACK_SECRET=
# Encrypts chat history at rest
MASOMLIMI_DATA_KEY=
MASOMLIMI_DATA_SALT=
MASOMLIMI_PRIVACY_SALT=
# Where data lives (put on an encrypted, backed-up volume)
MASOMLIMI_DATA_DIR=/var/lib/masomlimi
# Case memory retention in days
MASOMLIMI_RETENTION_DAYS=180
# Allowed browser origins for any web client (the portal is same-origin and needs none). Comma separated.
MASOMLIMI_CORS=
# Set to 1 only behind your own reverse proxy that sets X-Forwarded-For
MASOMLIMI_TRUST_PROXY=
# Hide /docs in production
MASOMLIMI_HIDE_DOCS=1
# Chat thresholds (calibrate on expert-labelled questions before production)
MASOMLIMI_CHAT_MIN_COVERAGE=0.34
MASOMLIMI_CHAT_HIGH_COVERAGE=0.60
# Optional: translate approved text when no translation exists (translation only, number-verified)
MASOMLIMI_LLM_API_KEY=
MASOMLIMI_LLM_BASE=https://api.openai.com/v1/chat/completions
MASOMLIMI_LLM_MODEL=gpt-4o-mini
